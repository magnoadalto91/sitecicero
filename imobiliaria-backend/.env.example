# Banco de dados Railway PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_forte

# Porta local
PORT=5000

# URL do frontend (Railway)
FRONTEND_URL=https://SEU-FRONTEND.up.railway.app

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Admin inicial (só para rodar db/seed.js)
ADMIN_USERNAME=cicero
ADMIN_PASSWORD=troque_essa_senha
